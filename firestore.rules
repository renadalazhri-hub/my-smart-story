rules_version = '2';

// Paste into Firebase console → Firestore Database → Rules, then Publish.
// Each signed-in user can only read, add and delete the stories in their own folder.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/stories/{storyId} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid
                    && request.resource.data.keys().hasOnly(['title', 'story', 'cover', 'createdAt'])
                    && request.resource.data.createdAt == request.time;
    }
  }
}
